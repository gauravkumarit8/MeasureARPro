<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      Required on Android 11+ (API 30+): without this <queries> declaration,
      ArCoreApk.checkAvailability() can return UNKNOWN_ERROR even when ARCore
      IS installed, because package visibility is restricted by default.
      See PRD Section 6 / Phase 1 compliance notes.
    -->
    <queries>
        <package android:name="com.google.ar.core" />
    </queries>

    <application
        android:name=".MeasureARProApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MeasureARPro"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <!--
          ARCore declared "optional" — keeps the app visible to all devices on
          the Play Store. AR-dependent features fall back to Screen Ruler via
          ArSessionManager.checkAvailability() at runtime (see :core-ar).
        -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MeasureARPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Scoped-storage-safe file sharing for PDF/QR exports (core-export).
          Raw file:// URIs throw FileUriExposedException on API 24+ — every
          export/share action must go through this provider's content:// URIs.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.measurear.pro.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
