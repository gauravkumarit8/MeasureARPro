{
  "name": "MeasureAR Pro (Android)",
  "image": "mcr.microsoft.com/devcontainers/java:17",
  "hostRequirements": {
    "cpus": 4
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installGradle": true,
      "gradleVersion": "8.13"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-android-sdk.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-gradle",
        "redhat.vscode-xml"
      ]
    }
  },
  "remoteEnv": {
    "ANDROID_HOME": "/home/vscode/android-sdk",
    "PATH": "${containerEnv:PATH}:/home/vscode/android-sdk/cmdline-tools/latest/bin:/home/vscode/android-sdk/platform-tools:/home/vscode/android-sdk/emulator"
  }
}
